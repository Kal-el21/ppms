# Server
APP_ENV=development
APP_PORT=8080
APP_NAME=ppms-backend

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=ppms_user
DB_PASSWORD=change_me
DB_NAME=ppms_db
DB_SSLMODE=disable

FRONTEND_URL=http://localhost:5174

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:8081

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET=ppms-attachments
MINIO_USE_SSL=false

# Email (Gmail SMTP)
# Aktifkan 2-Step Verification di akun Gmail, lalu buat App Password di:
# myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SMTP_FROM=PPMS Internal <yourname@gmail.com>

# Bcrypt
BCRYPT_COST=12
