# Application
APP_ENV=development
APP_PORT=8080
APP_NAME=ppms-backend

# PostgreSQL container
POSTGRES_USER=ppms_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ppms_db
POSTGRES_HOST_PORT=5433

# Backend database
DB_HOST=postgres
DB_PORT=5432
DB_USER=ppms_user
DB_PASSWORD=change_me
DB_NAME=ppms_db
DB_SSLMODE=disable

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# MinIO container
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_secret
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# Backend MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET=ppms-attachments
MINIO_USE_SSL=false

# Bcrypt
BCRYPT_COST=12

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:8081

# Docker Compose host ports
BACKEND_PORT=8081
FRONTEND_PORT=5174

# Frontend
FRONTEND_URL=http://localhost:5174
VITE_API_BASE_URL=http://localhost:8081/api/v1
